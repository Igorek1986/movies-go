# ── Superuser (created at startup if set) ─────────────────────────────────────
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme

# ── TMDB (enrichment disabled if not set) ─────────────────────────────────────
TMDB_TOKEN=Bearer eyJ...

# ── Overrides (optional, defaults shown) ──────────────────────────────────────
# PORT=8888
# DB_USER=movies_api
# DB_PASSWORD=movies_api
# DB_NAME=movies_api

# ── Cloudflare bypass for kinozal (optional, off by default) ──────────────────
# Uncomment to bring up warp+flaresolverr+cffetch alongside the app
# (docker-compose.cfbypass.yml) — see README's "Обход Cloudflare для kinozal".
# COMPOSE_PROFILES=cfbypass
